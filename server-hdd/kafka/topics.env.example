# Topic contract shared manually with the two Kafka Connect workers; it contains no credentials.
CDC_TOPIC_KARDEX=sqlserver.my_db_transaction.dbo.SI_FinKardex
CDC_TOPIC_AGENCIA=sqlserver.my_db_transaction.dbo.SI_FinAgenciaCCE
CDC_TOPIC_CANAL=sqlserver.my_db_transaction.dbo.SI_FinCanalCCE
# Kafka Connect internal topics are exclusive to each worker and must be compacted.
DEBEZIUM_CONNECT_CONFIG_TOPIC=arify-debezium-configs
DEBEZIUM_CONNECT_OFFSET_TOPIC=arify-debezium-offsets
DEBEZIUM_CONNECT_STATUS_TOPIC=arify-debezium-status
SINK_CONNECT_CONFIG_TOPIC=arify-sink-configs
SINK_CONNECT_OFFSET_TOPIC=arify-sink-offsets
SINK_CONNECT_STATUS_TOPIC=arify-sink-status
# Debezium schema history stores records without keys; it must use delete retention, not compaction.
SCHEMA_HISTORY_TOPIC=arify-schema-history.sqlserver
