# Standalone KRaft configuration; the advertised host must be reachable by Kafka clients.
TZ=America/Lima
# Generar una sola vez y conservar para no reinicializar el cluster KRaft.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Debe coincidir con el endpoint alcanzable por Kafka Connect.
KAFKA_ADVERTISED_HOST=192.168.3.219
KAFKA_ADVERTISED_PORT=9092
