TZ=America/Lima
# Must match the endpoint advertised by the Kafka broker.
KAFKA_BOOTSTRAP_SERVERS=192.168.3.219:9092
CONNECT_GROUP_ID=arify-sink-connect
CONNECT_CONFIG_TOPIC=arify-sink-configs
CONNECT_OFFSET_TOPIC=arify-sink-offsets
CONNECT_STATUS_TOPIC=arify-sink-status
CDC_TOPIC_KARDEX=sqlserver.my_db_transaction.dbo.SI_FinKardex
CDC_TOPIC_AGENCIA=sqlserver.my_db_transaction.dbo.SI_FinAgenciaCCE
CDC_TOPIC_CANAL=sqlserver.my_db_transaction.dbo.SI_FinCanalCCE
SCYLLA_CONTACT_POINTS=192.168.3.204
SCYLLA_LOCAL_DC=datacenter1
SCYLLA_KEYSPACE=arify_cqrs
# Use the least-privileged ScyllaDB role; set its real secret only in .env.
SCYLLA_SINK_USERNAME=arify_kafka_sink
SCYLLA_SINK_PASSWORD=CHANGE_ME
KAFKA_CONNECT_URL=http://127.0.0.1:8084
