TZ=America/Lima
# Must match the endpoint advertised by the Kafka broker.
KAFKA_BOOTSTRAP_SERVERS=192.168.3.219:9092
CONNECT_GROUP_ID=arify-debezium-connect
CONNECT_CONFIG_TOPIC=arify-debezium-configs
CONNECT_OFFSET_TOPIC=arify-debezium-offsets
CONNECT_STATUS_TOPIC=arify-debezium-status
SCHEMA_HISTORY_TOPIC=arify-schema-history.sqlserver
CDC_TOPIC_PREFIX=sqlserver
SQLSERVER_HOST=192.168.3.219
SQLSERVER_PORT=1433
# Stable restored database captured by Debezium.
SQLSERVER_DB=my_db_transaction
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=CHANGE_ME
KAFKA_CONNECT_URL=http://127.0.0.1:8083
