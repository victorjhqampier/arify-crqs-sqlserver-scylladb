{
  "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
  "tasks.max": "1",
  "database.hostname": "${env:SQLSERVER_HOST}",
  "database.port": "${env:SQLSERVER_PORT}",
  "database.user": "${env:DEBEZIUM_USER}",
  "database.password": "${env:DEBEZIUM_PASSWORD}",
  "database.names": "${env:SQLSERVER_DB}",
  "database.encrypt": "false",
  "database.trustServerCertificate": "true",
  "topic.prefix": "${env:CDC_TOPIC_PREFIX}",
  "table.include.list": "dbo\\.SI_FinKardex,dbo\\.SI_FinAgenciaCCE,dbo\\.SI_FinCanalCCE",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "schema.history.internal.kafka.bootstrap.servers": "${env:KAFKA_BOOTSTRAP_SERVERS}",
  "schema.history.internal.kafka.topic": "${env:SCHEMA_HISTORY_TOPIC}",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "include.schema.changes": "false",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "unwrap",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.delete.tombstone.handling.mode": "tombstone"
}
